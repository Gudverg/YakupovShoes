<Page x:Class="yakupov41.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakupov41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServicePage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="Вы авторизованы как:" FontSize="16" Margin="5"/>
            <TextBlock Name="FIOTB" FontSize="16" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Роль" FontSize="16" Margin="5"/>
            <TextBlock Name="RoleTB" FontSize="16" FontWeight="Bold" Margin="5"/>
        </StackPanel>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="800">
            <StackPanel Margin="20,50,-100,0" Orientation="Vertical">
                <TextBlock Text="Введите название для поиска" Name="TBCount" Width="300" FontSize="20"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="300" FontSize="15"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Height="60" Margin="300,50,-100,0">
                <TextBlock Text=" Фильтрация по скидке"
                    Width="250" FontSize="20"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged"
                   FontSize="15" Width="250">
                    <TextBlock>Все</TextBlock>
                    <TextBlock> от 0 до 9,99%</TextBlock>
                    <TextBlock> от 10 до 14,99%</TextBlock>
                    <TextBlock> от 15%</TextBlock>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
                <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RButtonUp_Checked" Name="RButtonUp"></RadioButton>
                <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="300" FontSize="20" Checked="RButtonDown_Checked" Name="RButtonDown"></RadioButton>
            </StackPanel>
        </WrapPanel>
        <ListView Name="ProductListView" Grid.Row="2" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="100" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /Res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" TextWrapping="Wrap" FontSize="11"></TextBlock>
                            <TextBlock Text="{Binding ProductManufacturer}" ></TextBlock>
                            <TextBlock Text="{Binding ProductCost,StringFormat={}{0:0} рублей}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" Margin="0,0,0,35"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0}%}"  HorizontalAlignment="Center" FontSize="20" FontFamily="Comic Sans MS" ></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
    </Grid>
</Page>
