<Page x:Class="yakupov41.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakupov41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServicePage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,5">
            <Button Name="OrderBtn" Content="Просмотр заказа" Width="180" Height="35" FontSize="15"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="OrderBtn_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Вы авторизованы как:" FontSize="15" Margin="5"/>
                <TextBlock Name="FIOTB" FontSize="15" FontWeight="Bold" Margin="5"/>
                <TextBlock Text="Роль:" FontSize="15" Margin="10,5,5,5"/>
                <TextBlock Name="RoleTB" FontSize="15" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <TextBlock Name="TBCount" Text="кол-во 0 из 0" FontSize="16" VerticalAlignment="Center" Margin="10,0,15,0"/>

            <StackPanel Orientation="Vertical" Margin="10,0">
                <TextBlock Text="Поиск по наименованию" FontSize="15"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="200" FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="15,0">
                <RadioButton Content="по возрастанию стоимости" GroupName="Sort" FontSize="14" Checked="RButtonUp_Checked" Name="RButtonUp"/>
                <RadioButton Content="по убыванию стоимости" GroupName="Sort" FontSize="14" Checked="RButtonDown_Checked" Name="RButtonDown"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0">
                <TextBlock Text="Фильтрация по скидке" FontSize="15"/>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="14" Width="180">
                    <TextBlock>Все диапазоны</TextBlock>
                    <TextBlock>от 0 до 9,99%</TextBlock>
                    <TextBlock>от 10 до 14,99%</TextBlock>
                    <TextBlock>от 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>
        <ListView Name="ProductListView" Grid.Row="2" HorizontalContentAlignment="Stretch">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="90" Height="90" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductDescription}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding ProductManufacturer}" FontSize="13"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" HorizontalAlignment="Center" FontSize="20"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>