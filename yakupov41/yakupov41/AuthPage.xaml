<Page x:Class="yakupov41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:yakupov41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Введите логин:" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="TBoxLogin" Height="35" Width="300" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Введите пароль:" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="TBoxPassword" Width="300" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>
        <Button Grid.Row="2" Grid.Column="0" Content="Войти как гость" Name="BtnGuest" Width="180" Height="40" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10" Click="BtnGuest_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Content="Войти" Name="BtnLogin" Width="130" Height="40" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="30" Click="LoginBtn_Click"/>
        <StackPanel x:Name="CaptchaPanel" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"/>
                <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"/>
                <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"/>
                <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"/>
            </StackPanel>
            <TextBox Name="TBoxCaptchaInput" Width="150" Height="30" HorizontalAlignment="Left" Margin="30,10,0,0" FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>
