<Window x:Class="yakupov41.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yakupov41"
        mc:Ignorable="d"
        Title="Оформление заказа" Height="550" Width="800" FontFamily="Comic Sans MS"
        WindowStartupLocation="CenterScreen" Icon="Res/icon.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата формирования заказа" FontSize="15" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Row="0" Grid.Column="1" Name="OrderDP" FontSize="15" Margin="5" SelectedDateChanged="OrderDP_SelectedDateChanged"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата доставки заказа" FontSize="15" VerticalAlignment="Center" Margin="5"/>
        <DatePicker Grid.Row="1" Grid.Column="1" Name="DeliveryDP" FontSize="15" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="ФИО клиента" FontSize="15" VerticalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Name="ClientTB" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Номер заказа" FontSize="15" VerticalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Name="TBOrderID" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="5"/>

        <ListView Name="ShoeListView" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="90" Height="90" Grid.Column="0" Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Res/picture.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">
                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding ProductDescription}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="{Binding ProductManufacturer}" FontSize="12"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Name="BtnMinus" Content="-" Width="30" Height="30" FontSize="16" Click="BtnMinus_Click"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="18" VerticalAlignment="Center" Margin="10,0"/>
                                <Button Name="BtnPlus" Content="+" Width="30" Height="30" FontSize="16" Click="BtnPlus_Click"/>
                                <Button Name="BtnDelete" Content="Удалить" Width="90" Height="30" FontSize="14" Margin="15,0,0,0" Click="BtnDelete_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <TextBlock Text="Скидка" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" FontSize="18" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Пункт выдачи" FontSize="15" VerticalAlignment="Center" Margin="5"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Name="PickupCombo" DisplayMemberPath="FullAddress" FontSize="15" Margin="5"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Name="TBTotalSum" Text="Сумма заказа: 0 руб." FontSize="16" FontWeight="Bold" Margin="10,0"/>
            <TextBlock Name="TBTotalDiscount" Text="Сумма скидки: 0 руб." FontSize="16" Margin="10,0"/>
        </StackPanel>

        <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Name="SaveBtn" Content="Сохранить"
                Width="180" Height="35" FontSize="18" HorizontalAlignment="Center" Margin="5" Click="SaveBtn_Click"/>
    </Grid>
</Window>